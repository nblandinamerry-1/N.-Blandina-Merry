        "# Define frequency bands (Hz)\n",
        "frequency_bands = {\n",
        "    'Delta': (0.5, 4),\n",
        "    'Theta': (4, 8),\n",
        "    'Alpha': (8, 12),\n",
        "    'Beta': (12, 30),\n",
        "    'Gamma': (30, 45) # Adjusted Gamma band upper limit for common EEG analysis\n",
        "}\n",
        "\n",
        "sfreq = raw.info['sfreq'] # Sampling frequency\n",
        "\n",
        "all_epochs_features = []\n",
        "\n",
        "for i, epoch_data in enumerate(epochs.get_data()):\n",
        "    epoch_features_row = []\n",
        "    # Iterate through each channel in the epoch\n",
        "    for ch_idx in range(epoch_data.shape[0]):\n",
        "        channel_data = epoch_data[ch_idx, :]\n",
        "\n",
        "        # Calculate Power Spectral Density (PSD) using Welch's method\n",
        "        # nperseg is the length of each segment, typically chosen to be a power of 2\n",
        "        # or such that there is sufficient overlap. Here, using half the number of samples.\n",
        "        nperseg = min(256, len(channel_data))\n",
        "        freqs, psd = welch(channel_data, sfreq, nperseg=nperseg, average='mean')\n",
        "\n",
        "        # Extract power for each frequency band\n",
        "        for band_name, (fmin, fmax) in frequency_bands.items():\n",
        "            idx_band = np.logical_and(freqs >= fmin, freqs <= fmax)\n",
        "            band_power = np.sum(psd[idx_band])\n",
        "            epoch_features_row.append(band_power)\n",
        "    all_epochs_features.append(epoch_features_row)\n",
        "\n",
        "# Create column names for the new DataFrame\n",
        "channel_names = epochs.ch_names\n",
        "new_column_names = []\n",
        "for ch_name in channel_names:\n",
        "    for band_name in frequency_bands.keys():\n",
        "        new_column_names.append(f'PSD_{band_name}_{ch_name}')\n",
        "\n",
        "df_psd_features = pd.DataFrame(all_epochs_features, columns=new_column_names)\n",
        "df_psd_features['Label'] = labels # Add labels\n",
        "\n",
        "print(\"PSD Features DataFrame head:\")\n",
        "display(df_psd_features.head())"
